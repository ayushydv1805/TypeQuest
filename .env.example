# Copy this file to .env.local and enter a dedicated TypeQuest Supabase project's values.
# Use the project URL and the publishable key from the Supabase dashboard.
# Never put a service_role key or Supabase secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
